# aether-infra — クライアント（手元のマシン）側の SSH 設定サンプル
#
# ~/.ssh/config か、そこから Include されているディレクトリに置く。
# 例: ~/.ssh/conf.d/<任意>/incus.conf
#
# <> で囲った箇所は自分の環境の値に置き換えること。
# 実際のホスト名・IP・鍵のパスはこのリポジトリではなく手元の設定に書く。

Host <踏み台のエイリアス>
    HostName        <サーバーのIPまたはホスト名>
    User            ubuntu
    IdentityFile    ~/.ssh/key.d/<鍵名>

# Incus コンテナ。
# ProxyJump は接続先ホスト名を踏み台側で解決するため、
# ホストの systemd-resolved に登録済みの .aether 名がそのまま通る。
# プロジェクトを増やしてもこのブロックの編集は不要。
Host *.aether
    User                    dev
    IdentityFile            ~/.ssh/key.d/<鍵名>
    ProxyJump               <踏み台のエイリアス>
    # プロジェクトを作り直すとホスト鍵が変わるため known_hosts を分けておく
    UserKnownHostsFile      ~/.ssh/known_hosts.aether
    StrictHostKeyChecking   accept-new
