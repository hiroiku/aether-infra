#!/usr/bin/env bash
# Managed by aether-infra
#
# プロジェクトを 1 コマンドで作る。
# プロジェクト名とコンテナ名を一致させることで、<名前>.{{ incus_dns_domain }} で
# 名前解決できるようにしている（固定 IP の採番も SSH config の追記も不要になる）。
set -euo pipefail

NAME="${1:-}"
MEM="${2:-{{ default_memory }}}"
CPU="${3:-{{ default_cpu }}}"
DISK="${4:-}"
IMAGE={{ golden_image_alias }}

usage() {
  cat <<'USAGE'
usage: newproj <name> [mem] [cpu] [disk]

  例:
    newproj blog                    # 既定 (mem / cpu はグローバル設定)
    newproj api 768MiB 1            # 軽量
    newproj build 2GiB 4 30GiB      # ディスク上限つき
USAGE
  exit 1
}

[ -n "$NAME" ] || usage
[[ "$NAME" =~ ^[a-z][a-z0-9-]{0,30}$ ]] || { echo "名前は小文字英数字とハイフンのみ" >&2; exit 1; }
[[ "$CPU" =~ ^[0-9]+$ ]] && [ "$CPU" -ge 1 ] || { echo "cpu は 1 以上の整数で指定してください" >&2; exit 1; }

if incus project list -f csv | cut -d, -f1 | sed 's/ (current)$//' | grep -qx "$NAME"; then
  echo "既に存在します: $NAME" >&2; exit 1
fi
incus image info "$IMAGE" >/dev/null 2>&1 || {
  echo "イメージ $IMAGE がありません。image/build-dev-base.sh を実行してください。" >&2; exit 1; }

# CPU はピン留め（limits.cpu=N）ではなく CFS クォータで制限する。
#   - limits.cpu=N        -> cpuset に固定され、空きコアがあっても使えない
#   - allowance=N00ms/100ms -> ピン留めなし。スケジューラが全コアを使える
# なお allowance のパーセント形式（例 200%）は相対的な重みであって
# ハードキャップにならないため、必ず時間スライス形式を使う。
ALLOWANCE="$((CPU * 100))ms/100ms"

echo "→ プロジェクト作成"
incus project create "$NAME" -c features.profiles=false -c features.images=false >/dev/null

echo "→ コンテナ起動"
incus launch "$IMAGE" "$NAME" --project "$NAME" >/dev/null
incus config set "$NAME" limits.memory="$MEM" limits.cpu.allowance="$ALLOWANCE" --project "$NAME"

if [ -n "$DISK" ]; then
  incus config device override "$NAME" root size="$DISK" --project "$NAME" >/dev/null
  incus restart "$NAME" --project "$NAME"
fi

printf "→ 起動待ち"
ip=""
for _ in $(seq 60); do
  ip=$(incus list "$NAME" -c 4 -f csv --project "$NAME" 2>/dev/null | awk '{print $1}' || true)
  [ -n "$ip" ] && break
  printf "."
  sleep 1
done
echo
[ -n "$ip" ] || { echo "IP を取得できませんでした。incus list --project $NAME で確認してください" >&2; exit 1; }

cat <<MSG

完了: $NAME  (mem=$MEM / cpu=${CPU}コア相当(クォータ) / disk=${DISK:-無制限} / $ip)

  接続   : herdr --remote ${NAME}.{{ incus_dns_domain }}
  シェル : ssh ${NAME}.{{ incus_dns_domain }}
  ホスト : pj ${NAME}
MSG
