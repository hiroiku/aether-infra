#!/usr/bin/env bash
# Managed by aether-infra
#
# プロジェクトをスナップショットごと完全に削除する。
set -euo pipefail

NAME="${1:-}"
[ -n "$NAME" ] || { echo "usage: rmproj <name>" >&2; exit 1; }
[ "$NAME" = "default" ] && { echo "default は削除できません" >&2; exit 1; }

if ! incus project list -f csv | cut -d, -f1 | sed 's/ (current)$//' | grep -qx "$NAME"; then
  echo "存在しません: $NAME" >&2; exit 1
fi

echo "--- $NAME の中身 ---"
incus list --project "$NAME"

read -rp "スナップショットごと完全に削除します。よろしいですか? [y/N] " answer
[ "$answer" = "y" ] || { echo "中止しました"; exit 1; }

for instance in $(incus list --project "$NAME" -c n -f csv); do
  incus delete "$instance" --project "$NAME" --force
done
incus project delete "$NAME"

echo "削除しました: $NAME"
